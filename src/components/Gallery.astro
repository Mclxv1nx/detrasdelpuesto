---
const photos = [
  {
    src: "/img/indigena-vendiendo-productos.jpeg",
    alt: "Comerciante indígena vendiendo productos agrícolas en la vía pública",
    caption: "Productos agrícolas en la vía pública",
    place: "Otavalo",
    span: "wide",
  },
  {
    src: "/img/zona-de-otavalo.jpeg",
    alt: "Vista de una zona comercial de Otavalo con puestos ambulantes",
    caption: "El centro urbano como mercado extendido",
    place: "Otavalo",
    span: "tall",
  },
  {
    src: "/img/entrevista-a-municipal.jpeg",
    alt: "Entrevista a un agente municipal sobre el uso del espacio público",
    caption: "La versión municipal sobre el espacio público",
    place: "Ibarra",
    span: "",
  },
  {
    src: "/img/enrtrevistando-municial.jpeg",
    alt: "Equipo periodístico entrevistando a un funcionario municipal",
    caption: "Registro de la voz institucional",
    place: "Ibarra",
    span: "",
  },
  {
    src: "/img/edificio-de-seeguridad.jpeg",
    alt: "Edificio de seguridad ciudadana, punto de control del comercio ambulante",
    caption: "Control y regulación del comercio ambulante",
    place: "Ibarra",
    span: "",
  },
  {
    src: "/img/toma-de-evidencias.jpeg",
    alt: "Toma de evidencias fotográficas durante el trabajo de campo",
    caption: "Trabajo de campo y verificación",
    place: "Imbabura",
    span: "",
  },
  {
    src: "/img/camara-profesional.jpeg",
    alt: "Cámara profesional utilizada en el registro del reportaje",
    caption: "El registro documental del reportaje",
    place: "Imbabura",
    span: "",
  },
  {
    src: "/img/local-foto-grupo.jpeg",
    alt: "Equipo de investigación reunido durante el reportaje",
    caption: "El equipo detrás de la investigación",
    place: "Imbabura",
    span: "wide",
  },
];
---

<section class="section gallery" id="galeria">
  <div class="container">
    <header class="gallery__head reveal">
      <p class="eyebrow">Trabajo de campo</p>
      <h2>Imágenes desde el terreno</h2>
      <p class="gallery__intro">
        El registro visual del reportaje en Otavalo e Ibarra: los puestos, las
        voces institucionales y el equipo que documentó la investigación.
      </p>
    </header>

    <ul class="grid reveal">
      {
        photos.map((p, i) => (
          <li class:list={["card", p.span && `card--${p.span}`]}>
            <figure>
              <div class="card__media">
                <img
                  src={p.src}
                  alt={p.alt}
                  loading={i < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </div>
              <figcaption>
                <span class="card__place">{p.place}</span>
                <span class="card__caption">{p.caption}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery {
    background: var(--earth-200);
    border-block: 1px solid var(--earth-300);
  }

  .gallery__head {
    max-width: var(--measure);
    margin-bottom: var(--space-l);
  }

  .gallery__head h2 {
    font-size: var(--step-3);
    margin-block: var(--space-2xs) var(--space-xs);
  }

  .gallery__intro {
    color: var(--gray-700);
  }

  /* Mobile-first: una sola columna. */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-s);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .card {
    margin: 0;
  }

  .card figure {
    position: relative;
    margin: 0;
    height: 100%;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--navy-900);
    box-shadow: var(--shadow-s);
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .card__media {
    aspect-ratio: 4 / 3;
    height: 100%;
    overflow: hidden;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.7s var(--ease),
      filter 0.5s var(--ease);
  }

  .card figcaption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--space-m) var(--space-s) var(--space-s);
    color: var(--earth-100);
    background: linear-gradient(
      to top,
      rgb(16 28 46 / 0.92) 0%,
      rgb(16 28 46 / 0.6) 55%,
      transparent 100%
    );
    transition: opacity 0.4s var(--ease);
  }

  .card__place {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terracotta-soft);
  }

  .card__caption {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.3;
  }

  /* Interacción con el mouse ------------------------------------------- */

  @media (hover: hover) {
    .card figure::after {
      content: "";
      position: absolute;
      inset: 0;
      border: 1px solid transparent;
      border-radius: inherit;
      transition: border-color 0.4s var(--ease);
      pointer-events: none;
    }

    .card figure:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-l);
    }

    .card figure:hover::after {
      border-color: color-mix(in srgb, var(--terracotta) 70%, transparent);
    }

    .card figure:hover .card__media img {
      transform: scale(1.07);
      filter: saturate(1.1);
    }

    /* Al pasar el mouse por la galería, las demás fotos se atenúan. */
    .grid:hover .card figure {
      opacity: 0.62;
    }

    .grid:hover .card figure:hover {
      opacity: 1;
    }

    .card figure {
      transition:
        transform 0.5s var(--ease),
        box-shadow 0.5s var(--ease),
        opacity 0.4s var(--ease);
    }
  }

  .card figure:focus-within {
    transform: translateY(-6px);
    box-shadow: var(--shadow-l);
  }

  /* Tablet ------------------------------------------------------------- */
  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-m);
    }

    .card--wide {
      grid-column: span 2;
    }

    .card--wide .card__media {
      aspect-ratio: 16 / 9;
    }
  }

  /* Escritorio: mosaico editorial -------------------------------------- */
  @media (min-width: 62rem) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 220px;
    }

    .card figure {
      height: 100%;
    }

    .card__media {
      aspect-ratio: auto;
    }

    .card--wide {
      grid-column: span 2;
      grid-row: span 2;
    }

    .card--tall {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
</style>
