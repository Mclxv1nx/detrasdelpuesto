---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Detrás del Puesto — Comercio informal en Imbabura",
  description = "Reportaje sobre la dinámica del comercio informal en Otavalo e Ibarra: causas, cifras y el debate sobre el espacio público.",
  image = "/img/portada.jpeg",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#16263c" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonical).href} />
    <meta property="og:locale" content="es_EC" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <slot />

    <script>
      // Revelado bidireccional: los elementos se animan al entrar Y al salir,
      // permitiendo que la animación se re-dispare al hacer scroll en ambas direcciones.
      const selector =
        ".reveal, .reveal--left, .reveal--right, .reveal--scale, .reveal--rotate3d, .reveal--tilt, .reveal--tilt-inv, .reveal-stagger";
      const targets = document.querySelectorAll<HTMLElement>(selector);

      if (
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
        targets.length
      ) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              // Bidireccional: agrega al entrar, quita al salir
              entry.target.classList.toggle("is-visible", entry.isIntersecting);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.06 },
        );
        targets.forEach((t) => io.observe(t));
      } else {
        targets.forEach((t) => t.classList.add("is-visible"));
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% -120%;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--navy-900);
    color: var(--earth-100);
    border-radius: 0 0 var(--radius-m) var(--radius-m);
    text-decoration: none;
    transition: translate 0.2s var(--ease);
  }

  .skip-link:focus-visible {
    translate: -50% 0;
  }
</style>
