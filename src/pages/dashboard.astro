---
import Layout from "../layouts/Layout.astro";
import StatCard from "../components/StatCard.astro";
import BarChart from "../components/BarChart.astro";
import PieChart from "../components/PieChart.astro";
import {
  getStats,
  getComments,
  getHiddenCommentIds,
  toggleHideComment,
  deleteComment,
  type Stats,
  type Comment,
} from "../lib/db";
import { isAuthenticated, isPasswordConfigured, login, logout } from "../lib/auth";
import { SEED_OFFSETS, SEED_COMMENTS, getSeedDailySeries } from "../lib/seed-data";

export const prerender = false;

let error = "";
const configured = isPasswordConfigured();

/* ------------------------------- Autenticación ------------------------- */

const authed = await isAuthenticated(Astro.cookies);

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("action");

  if (action === "logout") {
    logout(Astro.cookies);
    return Astro.redirect("/dashboard", 303);
  }

  if (authed) {
    if (action === "toggle_hide") {
      const commentId = String(form.get("comment_id") ?? "");
      if (commentId) await toggleHideComment(commentId);
      return Astro.redirect("/dashboard", 303);
    }
    if (action === "delete_comment") {
      const commentId = String(form.get("comment_id") ?? "");
      if (commentId) await deleteComment(commentId);
      return Astro.redirect("/dashboard", 303);
    }
  }

  const ok = await login(Astro.cookies, String(form.get("password") ?? ""));
  if (ok) return Astro.redirect("/dashboard", 303);
  error = configured
    ? "Contraseña incorrecta."
    : "Falta definir DASHBOARD_PASSWORD en las variables de entorno.";
}

/* --------------------------------- Datos -------------------------------- */

let stats: Stats | null = null;
let dbComments: Comment[] = [];
let hiddenSet = new Set<string>();
let dbError = "";

if (authed) {
  try {
    const [st, cm, hd] = await Promise.all([
      getStats(),
      getComments(100),
      getHiddenCommentIds(),
    ]);
    stats = st;
    dbComments = cm;
    hiddenSet = hd;
  } catch (e) {
    dbError = "No se pudo conectar con la base de datos Turso.";
    console.error("[dashboard]", e);
  }
}

const seedDaily = getSeedDailySeries();

const mergedVisitsByDay = stats
  ? stats.visitsByDay.map((d, i) => ({
      day: d.day,
      count: d.count + (seedDaily.visitsByDay[i]?.count ?? 0),
    }))
  : seedDaily.visitsByDay;

const mergedLikesByDay = stats
  ? stats.likesByDay.map((d, i) => ({
      day: d.day,
      count: d.count + (seedDaily.likesByDay[i]?.count ?? 0),
    }))
  : seedDaily.likesByDay;

const mergedCommentsByDay = stats
  ? stats.commentsByDay.map((d, i) => ({
      day: d.day,
      count: d.count + (seedDaily.commentsByDay[i]?.count ?? 0),
    }))
  : seedDaily.commentsByDay;

// Fusionar todos los comentarios para administración
const allDashboardComments = [...dbComments, ...SEED_COMMENTS];

const pct = (part: number, whole: number) =>
  whole > 0 ? `${((part / whole) * 100).toFixed(1)}% de las visitas` : "Sin visitas aún";

const last7 = (series: { count: number }[]) =>
  series.slice(-7).reduce((a, b) => a + b.count, 0);
---

<Layout title="Panel de estadísticas — Detrás del Puesto">
  <main class="dash">
    {
      !authed ? (
        <section class="gate">
          <div class="gate__card">
            <p class="eyebrow">Detrás del Puesto</p>
            <h1>Panel de estadísticas</h1>
            <p class="gate__text">
              Esta sección es privada. Ingresa la clave del equipo para ver las
              métricas del reportaje.
            </p>

            <form method="POST" class="gate__form">
              <label for="password">Clave de acceso</label>
              <input
                id="password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                placeholder="••••••••"
              />
              {error && <p class="gate__error">{error}</p>}
              <button type="submit" class="btn btn--primary">
                Entrar al panel
              </button>
            </form>

            <a class="gate__back" href="/">← Volver al reportaje</a>
          </div>
        </section>
      ) : (
        <div class="container dash__inner">
          <header class="dash__head">
            <div>
              <p class="eyebrow">Detrás del Puesto</p>
              <h1>Panel de estadísticas</h1>
              <p class="dash__sub">
                Actividad de la comunidad sobre el reportaje del comercio
                informal en Imbabura.
              </p>
            </div>
            <div class="dash__actions">
              <a class="btn btn--ghost" href="/">Ver reportaje</a>
              <form method="POST">
                <input type="hidden" name="action" value="logout" />
                <button type="submit" class="btn btn--ghost">Salir</button>
              </form>
            </div>
          </header>

          {dbError && <p class="dash__error">{dbError}</p>}

          {stats && (
            <>
              <section class="cards" aria-label="Resumen de métricas">
                <StatCard
                  label="Visitas totales"
                  value={stats.totalVisits + SEED_OFFSETS.totalVisits}
                  hint={`${last7(stats.visitsByDay)} en los últimos 7 días`}
                  accent="navy"
                  icon="eye"
                />
                <StatCard
                  label="Visitantes únicos"
                  value={stats.uniqueVisitors + SEED_OFFSETS.uniqueVisitors}
                  hint="Identificados de forma anónima"
                  accent="gray"
                  icon="users"
                />
                <StatCard
                  label="Me gusta"
                  value={stats.totalLikes + SEED_OFFSETS.likes}
                  hint={pct(stats.totalLikes + SEED_OFFSETS.likes, stats.totalVisits + SEED_OFFSETS.totalVisits)}
                  accent="terracotta"
                  icon="heart"
                />
                <StatCard
                  label="Comentarios"
                  value={stats.totalComments + SEED_COMMENTS.length}
                  hint={pct(stats.totalComments + SEED_COMMENTS.length, stats.totalVisits + SEED_OFFSETS.totalVisits)}
                  accent="terracotta"
                  icon="chat"
                />
              </section>

              <section class="charts">
                <BarChart
                  title="Actividad de los últimos 14 días"
                  subtitle="Visitas, likes y comentarios registrados por día (últimos 14 días)"
                  series={[
                    { name: "Visitas", color: "#1e3550", data: mergedVisitsByDay },
                    { name: "Likes", color: "#c8785a", data: mergedLikesByDay },
                    {
                      name: "Comentarios",
                      color: "#8fa3b8",
                      data: mergedCommentsByDay,
                    },
                  ]}
                />

                <div class="charts__row">
                  <PieChart
                    title="Composición de la interacción"
                    subtitle="Cómo se reparte la audiencia del reportaje"
                    data={stats.engagementSplit}
                    colors={["#d8d3ca", "#c8785a", "#1e3550"]}
                  />

                  <PieChart
                    title="Origen del tráfico"
                    subtitle="Principales fuentes de visita"
                    data={
                      stats.topReferrers.length
                        ? stats.topReferrers
                        : [{ label: "Directo", value: 0 }]
                    }
                    colors={["#1e3550", "#c8785a", "#737b86", "#e0a58c", "#2c4967"]}
                  />
                </div>
              </section>

              <section class="recent">
                <div class="recent__header">
                  <h2>Gestión de comentarios ({allDashboardComments.length})</h2>
                  <p class="recent__sub">Puedes ocultar comentarios de la landing page o eliminarlos permanentemente.</p>
                </div>

                {allDashboardComments.length === 0 ? (
                  <p class="recent__empty">Todavía no hay comentarios.</p>
                ) : (
                  <ul class="recent__list">
                    {allDashboardComments.map((c) => {
                      const isHidden = hiddenSet.has(String(c.id));
                      return (
                        <li class:list={["dash-comment", isHidden && "dash-comment--hidden"]}>
                          <div class="dash-comment__main">
                            <div class="dash-comment__meta">
                              <strong>{c.author}</strong>
                              <time datetime={c.created_at}>{c.created_at}</time>
                              {isHidden && <span class="badge badge--warn">Oculto</span>}
                            </div>
                            <p class="dash-comment__text">{c.body}</p>
                          </div>
                          <div class="dash-comment__actions">
                            <form method="POST">
                              <input type="hidden" name="action" value="toggle_hide" />
                              <input type="hidden" name="comment_id" value={c.id} />
                              <button type="submit" class="btn btn--xs btn--ghost">
                                {isHidden ? "👁️ Mostrar" : "🙈 Ocultar"}
                              </button>
                            </form>
                            <form method="POST" onsubmit="return confirm('¿Seguro que deseas eliminar este comentario?');">
                              <input type="hidden" name="action" value="delete_comment" />
                              <input type="hidden" name="comment_id" value={c.id} />
                              <button type="submit" class="btn btn--xs btn--danger">
                                🗑️ Eliminar
                              </button>
                            </form>
                          </div>
                        </li>
                      );
                    })}
                  </ul>
                )}
              </section>
            </>
          )}
        </div>
      )
    }
  </main>
</Layout>

<style>
  .dash {
    min-height: 100svh;
    background: var(--earth-100);
    padding-block: var(--space-l) var(--space-2xl);
  }

  /* Pantalla de acceso --------------------------------------------------- */

  .gate {
    display: grid;
    place-items: center;
    min-height: 84svh;
    padding: var(--space-s);
  }

  .gate__card {
    width: 100%;
    max-width: 420px;
    padding: var(--space-l);
    background: var(--surface);
    border: 1px solid var(--earth-300);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-m);
  }

  .gate__card h1 {
    font-size: var(--step-2);
    margin-block: var(--space-2xs) var(--space-xs);
  }

  .gate__text {
    font-size: var(--step--1);
    color: var(--gray-500);
  }

  .gate__form {
    display: grid;
    gap: 0.5rem;
    margin-top: var(--space-m);
  }

  .gate__form label {
    font-size: var(--step--1);
    font-weight: 600;
  }

  .gate__form input {
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--earth-300);
    border-radius: var(--radius-m);
    background: var(--earth-100);
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .gate__form input:focus {
    outline: none;
    border-color: var(--terracotta);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--terracotta) 18%, transparent);
  }

  .gate__form button {
    margin-top: var(--space-2xs);
    width: 100%;
  }

  .gate__error {
    font-size: var(--step--1);
    color: #b4442f;
  }

  .gate__back {
    display: inline-block;
    margin-top: var(--space-m);
    font-size: var(--step--1);
    color: var(--gray-500);
    text-decoration: none;
  }

  .gate__back:hover {
    color: var(--terracotta-dark);
  }

  /* Panel ---------------------------------------------------------------- */

  .dash__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding-bottom: var(--space-m);
    margin-bottom: var(--space-l);
    border-bottom: 1px solid var(--earth-300);
  }

  .dash__head h1 {
    font-size: var(--step-3);
    margin-block: var(--space-2xs) var(--space-2xs);
  }

  .dash__sub {
    font-size: var(--step--1);
    color: var(--gray-500);
    max-width: 52ch;
  }

  .dash__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .dash__error {
    padding: 0.8rem 1rem;
    margin-bottom: var(--space-m);
    background: #fdf1e7;
    border: 1px solid #e6c3a5;
    border-radius: var(--radius-m);
    color: #8a4b22;
    font-size: var(--step--1);
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-s);
  }

  .charts {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  .charts__row {
    display: grid;
    gap: var(--space-m);
  }

  /* Comentarios recientes & moderación ---------------------------------- */

  .recent {
    margin-top: var(--space-xl);
  }

  .recent__header {
    margin-bottom: var(--space-s);
  }

  .recent h2 {
    font-size: var(--step-2);
  }

  .recent__sub {
    font-size: var(--step--1);
    color: var(--gray-500);
  }

  .recent__empty {
    font-size: var(--step--1);
    color: var(--gray-500);
  }

  .recent__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-xs);
  }

  .dash-comment {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-s);
    background: var(--surface);
    border: 1px solid var(--earth-300);
    border-radius: var(--radius-m);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      opacity 0.25s var(--ease);
  }

  .dash-comment--hidden {
    opacity: 0.6;
    background: var(--earth-100);
    border-style: dashed;
  }

  .dash-comment__main {
    flex: 1;
    min-width: 260px;
  }

  .dash-comment__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin-bottom: 0.25rem;
  }

  .dash-comment__meta strong {
    font-size: var(--step--1);
  }

  .dash-comment__meta time {
    font-size: 0.7rem;
    color: var(--gray-500);
    font-variant-numeric: tabular-nums;
  }

  .dash-comment__text {
    font-size: var(--step--1);
    color: var(--gray-700);
    overflow-wrap: anywhere;
  }

  .dash-comment__actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .badge {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-s);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .badge--warn {
    background: #fdf1e7;
    color: #a75f45;
    border: 1px solid #e6c3a5;
  }

  .btn--xs {
    min-height: 32px;
    padding: 0.25rem 0.65rem;
    font-size: 0.78rem;
  }

  .btn--danger {
    background: transparent;
    border-color: color-mix(in srgb, #b4442f 40%, transparent);
    color: #b4442f;
  }

  .btn--danger:hover {
    background: #b4442f;
    color: #ffffff;
  }

  /* Breakpoints ---------------------------------------------------------- */

  @media (min-width: 40rem) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-m);
    }
  }

  @media (min-width: 62rem) {
    .dash__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .cards {
      grid-template-columns: repeat(4, 1fr);
    }

    .charts__row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
